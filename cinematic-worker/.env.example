# ESN Cinematic AI GPU worker
# Copy to cinematic-worker/.env on the GPU machine and load it before starting.

# Required: review/accept the applicable LTX license yourself before setting true.
LTX_LICENSE_ACCEPTED=false

# Required. Generate a long random value. Never commit the real token.
CINEMATIC_API_TOKEN=

CINEMATIC_BIND=127.0.0.1
CINEMATIC_PORT=8765
CINEMATIC_OUTPUT_DIR=cinematic-worker/outputs
CINEMATIC_MAX_QUEUE=5

LTX_REPO=/opt/LTX-2
LTX_TRANSFORMER=models/ltx-2.5/diffusion_models/ltx-2.5-22b-distilled-transformer-bf16.safetensors
LTX_TEXT_ENCODER=models/ltx-2.5/text_encoders/gemma4-12b-with-proj-ltx-2.5-bf16.safetensors
LTX_VIDEO_VAE=models/ltx-2.5/vae/ltx-2.5-video-vae-bf16.safetensors
LTX_AUDIO_VAE=models/ltx-2.5/vae/ltx-2.5-audio-vae-bf16.safetensors
LTX_SPATIAL_UPSCALER=models/ltx-2.5/latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors
LTX_DETAILING_LORA=models/ltx-2.5/loras/ltx-2.5-22b-ic-lora-pixel-spatial-upscaler-x2-1.0.safetensors

# Optional custom ESN style LoRA after training.
LTX_ESN_LORA=
LTX_ESN_LORA_STRENGTH=0.8

# Memory controls.
LTX_OFFLOAD=cpu
LTX_QUANTIZATION=
