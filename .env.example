# Discord bot application token
DISCORD_TOKEN=

# Optional: register commands instantly in one server.
# If omitted, global Discord commands are used and can take longer to appear.
DISCORD_GUILD_ID=

# Your Discord user ID. This user always has ESN CAM control.
CAM_OWNER_USER_ID=

# Optional comma-separated Discord role IDs allowed to control ESN CAM.
CAM_ALLOWED_ROLE_IDS=

# ESN SMP
MC_HOST=esn.ggwp.cc
# Leave blank to use SRV/default port resolution.
MC_PORT=
# Microsoft account email for the Minecraft Java account used by ESN CAM.
MC_USERNAME=
MC_AUTH=microsoft
# Leave blank for automatic server-version detection.
MC_VERSION=

# Reconnect behavior
MC_RECONNECT_SECONDS=10

# Video output. 1080x1920 is a vertical Short/Reel/TikTok frame.
RECORD_WIDTH=1080
RECORD_HEIGHT=1920
# prismarine-viewer records frame counts; this value controls requested clip length.
RECORD_FPS=20
RECORD_VIEW_DISTANCE=8
RECORDINGS_DIR=recordings

# Optional public viewer. Set VIEWER_ENABLED=true to watch ESN CAM in a browser.
VIEWER_ENABLED=false
VIEWER_PORT=3000
